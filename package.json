{
  "name": "code-practice",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "ipad": "NODE_ENV=production bun --watch server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "bundle": "uv run python scripts/build_bundle.py",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw",
    "test": "bun run bundle && bun test",
    "verify": "bun run bundle && bun run typecheck && bun test && uv run pytest -q"
  },
  "trustedDependencies": [],
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.6",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2"
  }
}
